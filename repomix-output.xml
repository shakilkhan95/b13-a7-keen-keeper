'use client'

import { FriendContext } from "@/contexts/FriendsProvider";
import { useContext } from "react";
import { toast } from "react-toastify";

const FilterButton = () => {
    const {timeLine, setTimeLine, filter, setFilter} = useContext(FriendContext);
    
